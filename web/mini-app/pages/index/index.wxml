<view class="page-shell clock-page">
  <navigation-bar title="打卡" back="{{false}}" color="#172033" background="#eef3f9"></navigation-bar>

  <scroll-view class="page-scroll" scroll-y type="list">
    <view class="page-body" wx:if="{{loading}}">
      <view class="card clock-hero shadow-soft">
        <view class="row-between">
          <view class="skeleton-stack clock-skeleton__hero-copy">
            <view class="skeleton-block skeleton-text skeleton-text--md"></view>
            <view class="skeleton-block skeleton-text skeleton-text--sm"></view>
          </view>
          <view class="skeleton-block skeleton-pill"></view>
        </view>

        <view class="skeleton-block skeleton-text clock-skeleton__date"></view>
        <view class="skeleton-block clock-skeleton__time"></view>

        <view class="clock-config">
          <view class="clock-config__item skeleton-stack">
            <view class="skeleton-block skeleton-text skeleton-text--sm"></view>
            <view class="skeleton-block skeleton-text skeleton-text--md"></view>
          </view>
          <view class="clock-config__divider"></view>
          <view class="clock-config__item skeleton-stack">
            <view class="skeleton-block skeleton-text skeleton-text--sm"></view>
            <view class="skeleton-block skeleton-text skeleton-text--md"></view>
          </view>
        </view>
      </view>

      <view class="clock-actions">
        <view class="skeleton-block skeleton-button"></view>
        <view class="skeleton-block skeleton-button"></view>
      </view>

      <view class="card clock-section">
        <view class="row-between">
          <view class="skeleton-block skeleton-text skeleton-text--sm"></view>
          <view class="skeleton-block skeleton-text skeleton-text--sm"></view>
        </view>

        <view class="clock-record" wx:for="{{[1,2,3]}}" wx:key="*this">
          <view class="skeleton-stack clock-skeleton__record-copy">
            <view class="skeleton-block skeleton-text skeleton-text--md"></view>
            <view class="skeleton-block skeleton-text skeleton-text--sm"></view>
          </view>
          <view class="skeleton-block skeleton-pill"></view>
        </view>
      </view>
    </view>

    <view class="page-body" wx:else>
      <view class="card clock-hero shadow-soft">
        <view class="row-between">
          <view>
            <text class="clock-hero__title">{{user ? user.name : '未登录用户'}}</text>
            <text class="clock-hero__desc">{{user ? user.position : '请先登录'}}</text>
          </view>
          <view class="clock-hero__tag">今日考勤</view>
        </view>

        <text class="clock-hero__date">{{currentDateText}}</text>
        <text class="clock-hero__time">{{currentTimeText}}</text>

        <view class="clock-config" wx:if="{{config}}">
          <view class="clock-config__item">
            <text class="label">上课时间</text>
            <text class="value">{{config.work_start}}</text>
          </view>
          <view class="clock-config__divider"></view>
          <view class="clock-config__item">
            <text class="label">下课时间</text>
            <text class="value">{{config.work_end}}</text>
          </view>
        </view>
      </view>

      <view class="card clock-section clock-session-card" wx:if="{{isTeacher}}">
        <view class="row-between">
          <view>
            <text class="section-title">发起课堂考勤</text>
            <text class="section-subtitle">{{currentSession ? '当前考勤进行中，学生签到完会自动结束' : '设置截止时间后即可发起课堂考勤'}}</text>
          </view>
          <view class="badge {{currentSession ? 'badge-warning' : 'badge-success'}}">{{currentSession ? '进行中' : '可发起'}}</view>
        </view>

        <view class="clock-session__picker-grid">
          <view class="field">
            <text class="label">截止日期</text>
            <picker mode="date" data-field="deadline_date" value="{{sessionForm.deadline_date}}" bindchange="handleSessionPicker">
              <view class="input clock-picker-input">{{sessionForm.deadline_date}}</view>
            </picker>
          </view>
          <view class="field">
            <text class="label">截止时间</text>
            <picker mode="time" data-field="deadline_time" value="{{sessionForm.deadline_time}}" bindchange="handleSessionPicker">
              <view class="input clock-picker-input">{{sessionForm.deadline_time}}</view>
            </picker>
          </view>
        </view>

        <button
          class="btn-primary clock-session__button"
          loading="{{launchingSession}}"
          disabled="{{!!currentSession}}"
          bindtap="handleLaunchSession"
        >
          {{currentSession ? '等待当前考勤结束' : '立即发起考勤'}}
        </button>

        <view wx:if="{{currentSession}}" class="clock-session__teacher-panel">
          <view class="clock-session__summary">
            <view class="clock-session__stat">
              <text class="label">发起时间</text>
              <text class="value">{{currentSession.createdAtText}}</text>
            </view>
            <view class="clock-session__stat">
              <text class="label">截止时间</text>
              <text class="value">{{currentSession.deadlineAtText}}</text>
            </view>
          </view>

          <view class="clock-session__summary clock-session__summary--counts">
            <view class="clock-session__stat clock-session__stat--count">
              <text class="label">学生总数</text>
              <text class="value">{{currentSession.studentCount}}</text>
            </view>
            <view class="clock-session__stat clock-session__stat--count">
              <text class="label">已签到</text>
              <text class="value">{{currentSession.submittedCount}}</text>
            </view>
            <view class="clock-session__stat clock-session__stat--count">
              <text class="label">未签到</text>
              <text class="value">{{currentSession.pendingCount}}</text>
            </view>
          </view>

          <view class="clock-session__group" wx:if="{{currentSession.pendingStudents.length}}">
            <text class="label">未签到学生</text>
            <view class="clock-session__chips">
              <view class="clock-session__chip clock-session__chip--pending" wx:for="{{currentSession.pendingStudents}}" wx:key="id">{{item.name}}</view>
            </view>
          </view>

          <view class="clock-session__group" wx:if="{{currentSession.submissions.length}}">
            <text class="label">已签到学生</text>
            <view class="clock-session__chips">
              <view class="clock-session__chip" wx:for="{{currentSession.submissions}}" wx:key="id">{{item.student_name}}</view>
            </view>
          </view>
        </view>
        <view wx:else class="empty-state clock-session__empty">当前没有进行中的课堂考勤。</view>
      </view>

      <view class="card clock-section clock-session-card" wx:if="{{isStudent && currentSession}}">
        <view class="row-between">
          <view>
            <text class="section-title">教师发起考勤</text>
            <text class="section-subtitle">{{currentSession.hasSubmitted ? '本次课堂考勤已完成签到' : '请在截止前完成课堂签到'}}</text>
          </view>
          <view class="badge {{currentSession.hasSubmitted ? 'badge-success' : 'badge-warning'}}">{{currentSession.hasSubmitted ? '已签到' : '待签到'}}</view>
        </view>

        <view class="clock-session__meta">
          <view class="clock-session__meta-item">
            <text class="label">发起时间</text>
            <text class="value">{{currentSession.createdAtText}}</text>
          </view>
          <view class="clock-session__meta-item">
            <text class="label">截止时间</text>
            <text class="value">{{currentSession.deadlineAtText}}</text>
          </view>
        </view>

        <view class="clock-session__submitted" wx:if="{{currentSession.hasSubmitted}}">
          <text class="label">签到时间</text>
          <text class="value">{{currentSession.submittedAtText}}</text>
        </view>
        <button wx:else class="btn-primary clock-session__button" loading="{{sessionSubmitting}}" bindtap="handleSessionSubmit">立即签到</button>
      </view>

      <view class="clock-actions">
        <button
          class="btn-primary clock-actions__button"
          loading="{{submittingType === 'check_in'}}"
          data-type="check_in"
          bindtap="handlePunch"
        >
          签到
        </button>
        <button
          class="btn-secondary clock-actions__button clock-actions__button-light"
          loading="{{submittingType === 'check_out'}}"
          data-type="check_out"
          bindtap="handlePunch"
        >
          签退
        </button>
      </view>

      <view class="card clock-section clock-shortcut-card">
        <view class="row-between">
          <view>
            <text class="section-title">补卡申请</text>
     
          </view>
          <button class="btn-secondary clock-shortcut-card__button" bindtap="handleOpenMakeup">去补卡</button>
        </view>
      </view>

      <view class="card clock-section">
        <view class="row-between">
          <text class="section-title">今日记录</text>
          <text class="section-subtitle">{{todayRecords.length}} 条</text>
        </view>

        <view wx:if="{{todayRecords.length}}">
          <view class="clock-record" wx:for="{{todayRecords}}" wx:key="id">
            <view>
              <text class="clock-record__title">{{item.recordTypeLabel}}</text>
              <text class="clock-record__meta">{{item.checkTimeText}}</text>
            </view>
            <view class="badge badge-{{item.statusTone}}">{{item.statusLabel}}</view>
          </view>
        </view>
        <view wx:else class="empty-state">今天还没有打卡记录，点击上方按钮开始。</view>
      </view>

      <view class="card clock-section" wx:if="{{latestRecord}}">
        <view class="row-between">
          <text class="section-title">最近一次打卡</text>
          <view class="badge badge-{{latestRecord.statusTone}}">{{latestRecord.statusLabel}}</view>
        </view>
        <text class="clock-latest__title">{{latestRecord.recordTypeLabel}}</text>
        <text class="clock-latest__meta">{{latestRecord.checkTimeText}}</text>
      </view>

      <view class="card clock-section">
        <view class="row-between">
          <text class="section-title">课堂考勤记录</text>
          <text class="section-subtitle">{{sessionHistory.length}} 条</text>
        </view>

        <view wx:if="{{sessionHistory.length}}">
          <view class="clock-history-item" wx:for="{{sessionHistory}}" wx:key="id">
            <view class="row-between clock-history-item__top">
              <view>
                <text class="clock-history-item__title">课堂考勤</text>
                <text class="clock-history-item__meta">发起时间：{{item.createdAtText}}</text>
              </view>
              <view class="badge badge-{{item.statusTone}}">{{item.statusLabel}}</view>
            </view>

            <view class="clock-history-item__stats">
              <text class="clock-history-item__stat">截止：{{item.deadlineAtText}}</text>
              <text class="clock-history-item__stat">已签到 {{item.submittedCount}} / {{item.studentCount}}</text>
            </view>

            <text class="clock-history-item__desc" wx:if="{{isStudent}}">{{item.completionText}}</text>
            <text class="clock-history-item__desc" wx:elif="{{isTeacher}}">未签到 {{item.pendingCount}} 人</text>
          </view>
        </view>
        <view wx:else class="empty-state">当前还没有课堂考勤记录。</view>
      </view>
    </view>
  </scroll-view>
</view>
